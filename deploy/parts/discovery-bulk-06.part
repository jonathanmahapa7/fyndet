function fyndetBuildFootprint(string $email,array $env,bool $authorised):array{$r=[];foreach(fyndetFootprintHeadings() as $k=>$v)$r[$k]=['state'=>'not_found','items'=>[]];$r['security_exposure']['state']='source_unavailable';return ['footprint'=>$r];}
