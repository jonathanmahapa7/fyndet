if($a['footprint']['web_presence']['state']!=='partial_coverage')throw new RuntimeException('Thin coverage wrongly called negative');
if($a['footprint']['technical_associations']['state']!=='not_configured')throw new RuntimeException('Unconfigured technical source state broken');
if(count($a['discovery_trace'])!==3)throw new RuntimeException('Missing source trace');
if(($a['discovery_trace'][0]['state']??'')!=='not_configured')throw new RuntimeException('Tokenless source state broken');
if(fyndetVUrl('http://127.0.0.1/')!==null||fyndetVUrl('https://127.0.0.1/')!==null)throw new RuntimeException('Unsafe URL passed');
echo "PASS: shared production function and six sections\nPASS: policy, negative-state, source traces and SSRF URL checks\n";
