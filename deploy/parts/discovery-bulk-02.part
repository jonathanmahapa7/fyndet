 $host=strtolower((string)($p['host']??''));$allowed=['api.github.com','keys.openpgp.org','keyserver.ubuntu.com','www.gravatar.com'];
 if(!in_array($host,$allowed,true))return ['status'=>0,'body'=>''];
 $ip=fyndetVResolve($host);if(!$ip)return ['status'=>0,'body'=>''];
 $h=curl_init($url);curl_setopt_array($h,[CURLOPT_RETURNTRANSFER=>true,CURLOPT_FOLLOWLOCATION=>false,CURLOPT_CONNECTTIMEOUT=>3,CURLOPT_TIMEOUT=>$seconds,CURLOPT_PROTOCOLS=>CURLPROTO_HTTPS,CURLOPT_PROXY=>'',CURLOPT_NOPROXY=>'*',CURLOPT_RESOLVE=>["$host:443:$ip"],CURLOPT_SSL_VERIFYHOST=>2,CURLOPT_SSL_VERIFYPEER=>true,CURLOPT_USERAGENT=>'FyndEtEvidence/1.0',CURLOPT_HTTPHE