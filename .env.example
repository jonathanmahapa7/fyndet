APP_URL=https://fyndet.example
APP_NAME=FyndEt
APP_ENV=production
APP_KEY=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cpaneluser_fyndet
DB_USER=cpaneluser_fyndet
DB_PASS=
SESSION_SECURE=1
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
HIBP_API_KEY=
HIBP_ENABLED=0
MAIL_FROM=no-reply@fyndet.example
GITHUB_PUBLIC_COMMITS_ENABLED=0
GITHUB_TOKEN=
PAID_BILLING_ENABLED=0
SALES_EMAIL=

# Optional licensed public indexed-web evidence (exact-email self-check only)
BRAVE_SEARCH_ENABLED=0
BRAVE_SEARCH_API_KEY=

# Optional bounded certificate transparency metadata, email DOMAIN only
CERTIFICATE_TRANSPARENCY_ENABLED=0

# Must be confirmed against the licensed Brave Search plan if retaining snippets in reports
BRAVE_SEARCH_STORAGE_LICENSE_CONFIRMED=0

# PayFast recurring subscriptions (separate from Stripe; disabled by default)
# Use sandbox-specific merchant credentials and passphrase while testing.
PAYFAST_ENABLED=0
PAYFAST_MODE=sandbox
PAYFAST_LIVE_APPROVED=0
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_CURRENCY=ZAR
# Specify your approved final prices, including any applicable tax, in ZAR.
PAYFAST_PRICE_STARTER_ZAR=
PAYFAST_PRICE_PRO_ZAR=
PAYFAST_PRICE_BUSINESS_ZAR=
